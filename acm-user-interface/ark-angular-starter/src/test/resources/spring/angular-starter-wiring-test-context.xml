<?xml version="1.0" encoding="UTF-8"?>
<!--
  Test-only context for AngularResourceCopierWiringTest.

  It supplies the one collaborator the production context expects to be contributed by the rest of the application -
  the active-profile holder - and then imports the production context unchanged, so the test asserts on the real
  bean definitions rather than on a copy of them. Nothing here overrides a production property.
-->
<beans xmlns="http://www.springframework.org/schema/beans" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd">

    <bean id="acmSpringActiveProfile" class="com.armedia.acm.core.AcmSpringActiveProfile"/>

    <import resource="classpath:spring/spring-web-ark-angular-starter.xml"/>

</beans>
